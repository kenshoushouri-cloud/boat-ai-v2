[Unit]
Description=Every five minutes collect V5 forward data before each race cutoff

[Timer]
# JST 07:00..23:55. The runner itself only selects races due in 9..24min.
OnCalendar=*-*-* 07..23:0/5:00 Asia/Tokyo
Unit=boat-v5-forward-window.service
Persistent=false
AccuracySec=30s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
